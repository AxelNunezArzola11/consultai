# =============================================================================
# ConsultAI — Environment Variable Template
# Copy to .env.local and fill in values. Never commit .env.local to git.
# Mark all secrets as "Sensitive" in Vercel dashboard — they cannot be read back
# after saving, so store values in a password manager before pasting into Vercel.
# =============================================================================

# -----------------------------------------------------------------------------
# App config — REQUIRED at startup (app throws if missing)
# Set to the stable production alias, e.g. https://consultai.vercel.app
# NEVER use VERCEL_URL (per-deployment, Vercel Auth-protected)
# NEVER use window.location (client-side, wrong for server webhook construction)
# -----------------------------------------------------------------------------
APP_BASE_URL=

# -----------------------------------------------------------------------------
# Database — REQUIRED
# Neon connection string (pooled endpoint recommended for serverless)
# https://neon.tech/docs/connect/connect-from-any-app
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# PayPal — REQUIRED for Phase 1
# PAYPAL_ENV: "sandbox" | "live" — controls SDK script host and API base URL
# PAYPAL_BASE_URL must always be set explicitly; no hardcoded fallback in code
#   sandbox: https://api-m.sandbox.paypal.com
#   live:    https://api-m.paypal.com
# PAYPAL_WEBHOOK_ID is the webhook REGISTRATION id (bare 17-char Dashboard value)
#   NOT the WH-... event id. Updating the webhook URL requires a new ID.
# -----------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Safe to expose in browser (sandbox only)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# -----------------------------------------------------------------------------
# LLM — Phase 2+
# Groq: qwen/qwen3-32b is the VERIFIED tool-calling model (Spike 5)
#   llama-3.3-70b-versatile is NO LONGER listed on free tier — do not use
# Gemini: DO NOT set LLM_GEMINI_MODEL until you confirm the exact free model
#   name and rate limits at https://ai.google.dev/gemini-api/docs/models/gemini
# Default provider is "groq" until Gemini is confirmed
# -----------------------------------------------------------------------------
GROQ_API_KEY=
LLM_GROQ_MODEL=qwen/qwen3-32b
LLM_PROVIDER=groq
GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_GEMINI_MODEL=              # UNVERIFIED — confirm model name first

# -----------------------------------------------------------------------------
# BriefAgent limits — Phase 3
# Configurable per-environment; defaults listed below are applied in code
# -----------------------------------------------------------------------------
# BRIEF_MIN_MILESTONE_USD=100
# BRIEF_MAX_MILESTONE_USD=50000
# BRIEF_MAX_MILESTONES=6
# BRIEF_INPUT_MAX_CHARS=4000
# BRIEF_SESSION_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# GitHub — Phase 3+
# Public repo read scope only; keep server-side, never expose to browser
# https://github.com/settings/tokens
# -----------------------------------------------------------------------------
GITHUB_PAT=

# -----------------------------------------------------------------------------
# Cal.com — Phase 4+
# https://cal.com/docs/cal-com-webhooks
# -----------------------------------------------------------------------------
CAL_API_KEY=
CAL_WEBHOOK_SECRET=
CAL_EVENT_TYPE_ID=

# -----------------------------------------------------------------------------
# Elastic Cloud — Phase 3+
# 14-day trial; add trial expiry date to consultai-plan.md Spike 7 entry
# https://cloud.elastic.co
# -----------------------------------------------------------------------------
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=

# -----------------------------------------------------------------------------
# Upstash QStash — Phase 4+
# Rotate all keys from spike runs before using in production (see cleanup checklist)
# https://console.upstash.com
# Free max delay: 7 days (VERIFIED Spike 8)
# Free message count: UNVERIFIED — check https://upstash.com/pricing/qstash
# -----------------------------------------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Feature flags / policy
# AUTO_APPROVE_THRESHOLD_USD: payouts at or below this amount are auto-approved
# FEE_DISPLAY_POLICY: GROSS_ONLY | SHOW_FEE | COMPANY_ABSORBS
#   SHOW_FEE (default): show gross + fee + net; verified on $5.00 tx (Spike 1b)
#   Fee rates UNVERIFIED for other amounts — confirm at:
#     Orders: https://www.paypal.com/us/webapps/mpp/merchant-fees
#     Payouts: https://www.paypal.com/us/webapps/mpp/paypal-fees
# NDA_EXPIRY_DEMO_MINUTES: short window for live demo; use 2880 (48h) for production
# -----------------------------------------------------------------------------
AUTO_APPROVE_THRESHOLD_USD=500
FEE_DISPLAY_POLICY=SHOW_FEE
NDA_EXPIRY_DEMO_MINUTES=2
# DEMO_MODE=true enables /api/demo/* simulation routes (Simulate NDA Signed, Simulate Cancellation)
# Automatically enabled in development; set explicitly for staging
DEMO_MODE=true
RENDER_API_KEY=
DELIVERY_WORKFLOW_ENABLED=false
DELIVERY_WORKFLOW_SLUG=consultai-delivery
